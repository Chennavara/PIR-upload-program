
projection;
strict ( 2 );
use draft;

define behavior for ZC_PIR_UPLOAD alias Upload
{
  use create;
  use update;
  use delete;

  use association _Items { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action UploadExcel;

}

define behavior for ZC_PIR_ITEM alias Item
{
  use update;
  use delete;

  use association _Upload { with draft; }
}